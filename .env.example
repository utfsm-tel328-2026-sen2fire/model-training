# ============================================================
# Sen2Fire Training — variables de entorno
# ============================================================
#
# Cómo se carga este archivo:
#   src/sen2fire/data/config.py:env_lookup() construye un ChainMap(os.environ, file_values)
#   — es decir: las variables reales del SHELL siempre pisan a las de este archivo,
#   y el código NO muta os.environ al leerlo. Para probar overrides en una sola
#   corrida, anteponer la variable al comando:
#
#       SEN2FIRE_LOCAL_CACHE= NFS_SEN2FIRE_RUNS_ROOT=/srv/nfs/sen2fire_runs \
#           python train.py fit --config configs/baseline.yaml
#
# Esto es TODO lo que el sistema lee del entorno. Si querés meter una variable
# nueva para una nueva capacidad, sumala acá y dejá la nota correspondiente.

# ============================================================
# 1) Selección de dataset
# ============================================================
#
# Qué dataset del registro se instancia (ver src/sen2fire/data/registry.py).
# Por convención, sus variables específicas se leen con el prefijo
# <NOMBRE>_ROOT y <NOMBRE>_LOCAL_CACHE en MAYÚSCULAS
# (name.upper().replace("-", "_")).
DATASET=sen2fire

# ============================================================
# 2) Ubicación del dataset (variables <PREFIX>_* según DATASET)
# ============================================================
#
# === Para DATASET=sen2fire (registro actual) ===
# Ruta al dataset (NFS o local) con scene1/, scene2/, ...
SEN2FIRE_ROOT=/path/to/sen2fire

# Opcional. Si está definida, el dataset se clona una única vez a esta
# ruta local y toda la sesión lee desde ahí, en vez de ir a la red cada
# iter. Ponelo en /tmp: se borra solo al reiniciar la máquina.
#
# Al terminar la clonación se escribe un sello (`.dataset-cache.json`)
# en el destino: las corridas siguientes validan la copia local SIN tocar
# la montura de red. Se puede entrenar incluso con la NFS caída.
#
# SEN2FIRE_LOCAL_CACHE=/tmp/sen2fire_local

# === Cómo se ve si añadís otro dataset al registro ===
# DATASET=miotro
# MIOTRO_ROOT=/path/to/miotro
# MIOTRO_LOCAL_CACHE=/tmp/miotro_local       # opcional, mismo comportamiento

# ============================================================
# 3) Salida compartida para runs (NFS entre colaboradores)
# ============================================================
#
# Raíz para escribir checkpoints, TensorBoard logs y summary.json de cada
# run. Si no se define, todo cae a ./runs/<user>/<run_id>/ (local,
# gitignored). Recomendado en NFS para que ambos colaboradores compartan
# el árbol y vean los runs del otro.
#
# NFS_SEN2FIRE_RUNS_ROOT=/srv/nfs/sen2fire_runs

# ============================================================
# 4) Identidad del usuario (opcional)
# ============================================================
#
# Se usa para crear subdirectorios del estilo <runs_root>/<USER>/<run_id>/
# y para etiquetar cada línea en experiments.jsonl.
#
# Orden de fallback (src/sen2fire/training/registry.py:username):
#   1. $USER   (Linux)
#   2. $USERNAME (Windows)
#   3. getpass.getuser()
#   4. socket.gethostname()
#
# Sólo necesitás setearla a mano si tu shell no exporta $USER al arrancar.
# USER=khaen
